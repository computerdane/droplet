## Every known site code (SITES.rs order: roughly geographic groupings, not alphabetised).
static func ids() -> Array[String]:
	var out: Array[String] = []
	for code in LOCATIONS:
		out.append(code)
	return out


## Vector2(lat, lon) in degrees, or Vector2.INF if `site` is unknown.
static func location(site: String) -> Vector2:
	return LOCATIONS.get(site, Vector2.INF)


static func has(site: String) -> bool:
	return LOCATIONS.has(site)
